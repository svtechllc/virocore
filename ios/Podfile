platform :ios, '15.0'

# Disable Mac Catalyst - ViroKit uses GLKit and ARCore which are iOS-only
ENV['ONLY_ACTIVE_ARCH'] = 'NO'

def common_pods
    pod 'GVRAudioSDK', '1.140.0'
    # ARCore and its transitive dependencies are statically incorporated into
    # ViroKit so the distributed framework is self-contained.
    pod 'ARCore/CloudAnchors', '~> 1.56.0'
    pod 'ARCore/Geospatial', '~> 1.56.0'
    pod 'ARCore/Semantics', '~> 1.56.0'
end

target 'ViroSample' do
    use_frameworks!
end

target 'ViroKit' do
    use_frameworks! :linkage => :static
    common_pods
end
